<?xml version="1.0"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/13.3/phpunit.xsd" bootstrap="tests/phpunit/includes/bootstrap-phpunit13.php" backupGlobals="false" colors="true" beStrictAboutTestsThatDoNotTestAnything="true" beStrictAboutOutputDuringTests="true" failOnRisky="true" cacheDirectory=".phpunit.cache">
  <testsuites>
    <!-- Default test suite to run all tests. -->
    <testsuite name="default">
      <directory suffix=".php">tests/phpunit/tests</directory>
      <exclude>tests/phpunit/tests/rest-api/WP_Test_REST_Autosaves_Controller.php</exclude>
      <exclude>tests/phpunit/tests/admin/plugin-dependencies/base.php</exclude>
      <exclude>tests/phpunit/tests/block-templates/base.php</exclude>
      <exclude>tests/phpunit/tests/filesystem/base.php</exclude>
      <exclude>tests/phpunit/tests/filesystem/wpFilesystemDirect/base.php</exclude>
      <exclude>tests/phpunit/tests/fonts/font-face/base.php</exclude>
      <exclude>tests/phpunit/tests/fonts/font-face/wp-font-face-tests-dataset.php</exclude>
      <exclude>tests/phpunit/tests/fonts/font-library/wpFontLibrary/base.php</exclude>
      <exclude>tests/phpunit/tests/http/base.php</exclude>
      <exclude>tests/phpunit/tests/image/base.php</exclude>
      <exclude>tests/phpunit/tests/image/resize.php</exclude>
      <exclude>tests/phpunit/tests/media/testcase-adjacent-image-link.php</exclude>
      <exclude>tests/phpunit/tests/multisite</exclude>
      <exclude>tests/phpunit/tests/rest-api/rest-test-controller.php</exclude>
      <exclude>tests/phpunit/tests/theme/base.php</exclude>
    </testsuite>
    <!-- Sets the DOING_AUTOSAVE constant, so needs to be run last. -->
    <testsuite name="restapi-autosave">
      <file>tests/phpunit/tests/rest-api/WP_Test_REST_Autosaves_Controller.php</file>
    </testsuite>
  </testsuites>
  <groups>
    <exclude>
      <group>ajax</group>
      <group>ms-files</group>
      <group>ms-required</group>
      <group>external-http</group>
      <group>external-object-cache</group>
      <group>html-api-web-platform-tests</group>
    </exclude>
  </groups>
  <logging>
    <junit outputFile="tests/phpunit/build/logs/junit.xml"/>
  </logging>
  <php>
    <const name="WP_RUN_CORE_TESTS" value="1"/>
  </php>
  <source>
    <include>
      <directory suffix=".php">src</directory>
    </include>
    <exclude>
      <directory suffix=".php">src/wp-includes/ID3</directory>
      <directory suffix=".php">src/wp-includes/IXR</directory>
      <directory suffix=".php">src/wp-includes/PHPMailer</directory>
      <directory suffix=".php">src/wp-includes/Requests</directory>
      <directory suffix=".php">src/wp-includes/php-ai-client</directory>
      <directory suffix=".php">src/wp-includes/SimplePie</directory>
      <directory suffix=".php">src/wp-includes/sodium_compat</directory>
      <directory suffix=".php">src/wp-includes/Text</directory>
      <directory suffix=".php">src/wp-content/</directory>
      <file>src/wp-admin/includes/class-ftp*</file>
      <file>src/wp-admin/includes/class-pclzip.php</file>
      <file>src/wp-admin/includes/deprecated.php</file>
      <file>src/wp-admin/includes/ms-deprecated.php</file>
      <file>src/wp-includes/atomlib.php</file>
      <file>src/wp-includes/class-IXR.php</file>
      <file>src/wp-includes/class-json.php</file>
      <file>src/wp-includes/class-phpass.php</file>
      <file>src/wp-includes/class-pop3.php</file>
      <file>src/wp-includes/class-requests.php</file>
      <file>src/wp-includes/class-simplepie.php</file>
      <file>src/wp-includes/class-snoopy.php</file>
      <file>src/wp-includes/deprecated.php</file>
      <file>src/wp-includes/ms-deprecated.php</file>
      <file>src/wp-includes/pluggable-deprecated.php</file>
      <file>src/wp-includes/rss.php</file>
    </exclude>
  </source>
</phpunit>
